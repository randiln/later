rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function existingData() { return resource.data; }
    function incomingData() { return request.resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Admin UID — hardcoded for security rules (env vars not available here)
    function isAdmin() { return isSignedIn() && request.auth.uid == '9xawU3cCAwVBEhEJTAuAT6Ehtwk2'; }

    function getGallery(galleryId) {
      return get(/databases/$(database)/documents/galleries/$(galleryId)).data;
    }

    // --- Users ---
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId 
        && incomingData().keys().hasAll(['email', 'createdAt'])
        && incomingData().keys().size() == 2
        && incomingData().email == request.auth.token.email;
    }

    // --- Galleries ---
    match /galleries/{galleryId} {
      function isValidGalleryData(data) {
        return data.title is string && data.title.size() > 0 && data.title.size() <= 100
          && (data.get('description', '') is string && data.get('description', '').size() <= 500)
          && data.startsAt is timestamp
          && data.revealAt is timestamp
          && data.maxShots is int && data.maxShots > 0 && data.maxShots <= 10000
          && data.maxContributors is int && data.maxContributors > 0 && data.maxContributors <= 10000
          && data.creatorId is string
          && data.status is string
          && data.status in ['upcoming', 'active', 'revealed'];
      }

      function galleryStatus() {
        return getGallery(galleryId).status;
      }

      allow read: if true; 
      allow list: if isSignedIn() && resource.data.creatorId == request.auth.uid;

      // Regular users create galleries for themselves; admin can create for any user (for approved requests)
      allow create: if isVerified()
        && isValidGalleryData(incomingData())
        && (incomingData().creatorId == request.auth.uid || isAdmin())
        && incomingData().status == 'upcoming'
        && incomingData().createdAt == request.time;

      // Clients may update gallery fields but cannot change status — only the Cloud Function advances it
      allow update: if isVerified() && existingData().creatorId == request.auth.uid
        && isValidGalleryData(incomingData())
        && incomingData().status == existingData().status
        && incomingData().creatorId == existingData().creatorId;
      allow delete: if isVerified() && existingData().creatorId == request.auth.uid;

      // --- Contributors ---
      match /contributors/{contributorId} {
        function isValidContributor(data) {
          return data.galleryId == galleryId
            && data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 20
            && data.sessionId is string
            && data.shotsTaken is int && data.shotsTaken >= 0
            && data.createdAt is timestamp;
        }

        allow read: if true; 
        allow create: if isValidContributor(incomingData()) 
          && incomingData().shotsTaken == 0
          && incomingData().createdAt == request.time;
        allow update: if isValidContributor(incomingData())
          && incomingData().sessionId == existingData().sessionId
          && incomingData().createdAt == existingData().createdAt
          && (
            // Action: Increment shot count
            (incomingData().shotsTaken == existingData().shotsTaken + 1 
             && incomingData().diff(existingData()).affectedKeys().hasOnly(['shotsTaken']))
          );
        allow delete: if isSignedIn()
          && getGallery(galleryId).creatorId == request.auth.uid;
      }

      // --- Photos ---
      match /photos/{photoId} {
        // Timestamp checks remain as source-of-truth fallback
        function isRevealed() {
          return getGallery(galleryId).revealAt <= request.time;
        }
        function hasStarted() {
          return getGallery(galleryId).startsAt <= request.time;
        }

        // Primary: status field (fast path, set by Cloud Function)
        // Fallback: timestamp comparison (source of truth)
        allow read: if galleryStatus() == 'revealed' || isRevealed() || (isVerified() && getGallery(galleryId).creatorId == request.auth.uid);
        allow create: if (galleryStatus() == 'active' || (hasStarted() && !isRevealed()))
          && incomingData().galleryId == galleryId
          && incomingData().contributorId is string
          && incomingData().storagePath is string
          && incomingData().storagePath.size() > 0
          && incomingData().storagePath.size() <= 2048
          && incomingData().createdAt == request.time
          // Validate contributor exists and has shots left
          && get(/databases/$(database)/documents/galleries/$(galleryId)/contributors/$(incomingData().contributorId)).data.shotsTaken < getGallery(galleryId).maxShots;
        allow delete: if isSignedIn()
          && getGallery(galleryId).creatorId == request.auth.uid;
      }
    }

    // --- Custom Room Requests ---
    match /customRequests/{requestId} {
      // Any verified user can submit a request for themselves
      // Relaxed email check — just verify the uid matches (email may vary by auth provider)
      allow create: if isSignedIn()
        && incomingData().uid == request.auth.uid
        && incomingData().status == 'pending'
        && incomingData().eventTitle is string && incomingData().eventTitle.size() > 0 && incomingData().eventTitle.size() <= 100
        && incomingData().guestCount is int && incomingData().guestCount > 0 && incomingData().guestCount <= 10000
        && incomingData().shotsPerPerson is int && incomingData().shotsPerPerson > 0 && incomingData().shotsPerPerson <= 1000
        && incomingData().createdAt == request.time;

      // Requestor can read their own; admin can read all
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      // Admin can list all; regular users can only query their own (enforced by query filters)
      allow list: if isSignedIn() && (isAdmin() || request.auth != null);

      // Admin only can update (approve / reject)
      allow update: if isAdmin();

      allow delete: if false;
    }
  }
}
